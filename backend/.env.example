# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/coparenting
APP_DATABASE_URL=postgresql+asyncpg://app_user:password@db:5432/coparenting

# Auth
JWT_SECRET=your_jwt_secret_here
JOB_SECRET_TOKEN=your_job_token_here

# Vertex AI（AI 排程助理）
# Cloud Run 上使用 ADC 無需填寫；本地開發需執行 gcloud auth application-default login
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GCS
GCS_BUCKET_AUDIT=coparenting-audit-anchors
GCS_BUCKET_REPORTS=coparenting-reports
PDF_STORAGE_MODE=local

# KMS
KMS_MODE=local
LOCAL_ENCRYPT_KEY=your_base64_key_here

# Environment
ENV=development
